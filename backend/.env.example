# ==============================================================================
# INACAP E-COMMERCE - PLANTILLA DE CONFIGURACIÓN DE ENTORNO: example.env
# ==============================================================================
# 🤖 GUÍA PARA OTRA IA O DESARROLLADOR AUTOMATIZADO:
# ------------------------------------------------------------------------------
# Este archivo contiene todas las variables de entorno necesarias para replicar
# y ejecutar de forma 100% funcional el ecosistema completo (Django API + PostgreSQL + Vue 3).
#
# INSTRUCCIONES DE REPLICACIÓN RÁPIDA:
# 1. Copia este archivo a la carpeta backend con el nombre exacto '.env':
#    - Windows PowerShell: Copy-Item example.env backend\.env
#    - Linux / macOS:      cp example.env backend/.env
# 2. Si dispones de un servicio PostgreSQL corriendo en el puerto 5432:
#    - Crea la base de datos: CREATE DATABASE inacap_ecommerce;
#    - El sistema se conectará automáticamente mediante el driver nativo psycopg 3.
# 3. Si NO tienes PostgreSQL activo en tu máquina local:
#    - La variable 'DB_FALLBACK_SQLITE_IF_PG_UNAVAILABLE=True' activará de forma
#      transparente SQLite local para que las pruebas no fallen jamás.
# 4. Ejecuta las migraciones y semillero:
#    - python manage.py migrate
#    - python manage.py seed_ecommerce
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DEL NÚCLEO DJANGO
# ------------------------------------------------------------------------------
# DEBUG: Modo de depuración. 
# - En desarrollo: True (permite ver trazas de error y recarga en caliente).
# - En producción: False (obligatorio según ISO 27001 para no filtrar información sensible).
DEBUG=True

# SECRET_KEY: Clave criptográfica para firmas de sesiones, tokens CSRF y cookies.
# - En desarrollo: Puedes utilizar la clave por defecto suministrada abajo.
# - En producción: Debe generarse una cadena pseudoaleatoria de alta entropía (50+ caracteres).
SECRET_KEY=django-insecure-inacap-ecommerce-secure-key-iso27001-development-mode-2026

# ALLOWED_HOSTS: Lista de nombres de dominio o IPs permitidas para atender peticiones HTTP.
# Separadas por coma sin espacios adicionales.
ALLOWED_HOSTS=127.0.0.1,localhost


# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE BASE DE DATOS RELACIONAL (POSTGRESQL ORM VIA PSYCOPG 3)
# ------------------------------------------------------------------------------
# DB_ENGINE: Motor de base de datos de Django. Utiliza el backend nativo de PostgreSQL.
DB_ENGINE=django.db.backends.postgresql

# DB_NAME: Nombre de la base de datos relacional creada en PostgreSQL.
DB_NAME=inacap_ecommerce

# DB_USER: Usuario con privilegios de lectura, escritura y creación de tablas.
DB_USER=postgres

# DB_PASSWORD: Clave del usuario de base de datos.
# - En entornos locales con autenticación 'trust': Puedes dejarlo como 'postgres' o vacío.
# - En entornos productivos: Utilizar contraseñas robustas gestionadas por vault.
DB_PASSWORD=postgres

# DB_HOST: Dirección IP o hostname del servidor de base de datos.
# Utilizar 127.0.0.1 para conexiones loopback locales de alta velocidad.
DB_HOST=127.0.0.1

# DB_PORT: Puerto TCP por defecto de PostgreSQL.
DB_PORT=5432

# DB_FALLBACK_SQLITE_IF_PG_UNAVAILABLE: Resiliencia de arranque para desarrollo.
# - True: Si el sondeo al puerto 5432 falla o PostgreSQL está apagado, conmuta
#   automáticamente a SQLite sin abortar el arranque del servidor.
# - False: Obliga a fallar si PostgreSQL no responde.
DB_FALLBACK_SQLITE_IF_PG_UNAVAILABLE=True


# ------------------------------------------------------------------------------
# 3. SEGURIDAD DE RED Y POLÍTICA CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Orígenes autorizados para realizar peticiones HTTP a la API REST.
# Corresponde a la URL donde corre el frontend de Vue 3 (Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CORS_ALLOW_CREDENTIALS: Si se admiten cookies y cabeceras de autorización entre orígenes.
CORS_ALLOW_CREDENTIALS=True


# ------------------------------------------------------------------------------
# 4. AUTENTICACIÓN JWT (JSON WEB TOKENS) & SESIÓN SEGURA
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: Llave simétrica utilizada por HMAC-SHA256 para firmar y validar tokens JWT.
# Debe ser independiente y diferente a SECRET_KEY para segregación criptográfica (ISO 27001).
JWT_SECRET_KEY=inacap-jwt-super-secret-iso27001-signature-key-2026

# JWT_EXPIRATION_HOURS: Tiempo de vida del token de acceso antes de requerir nuevo login.
JWT_EXPIRATION_HOURS=24


# ------------------------------------------------------------------------------
# 5. POLÍTICAS DE SEGURIDAD ESTRICTAS (ISO/IEC 27001 & OWASP TOP 10)
# ------------------------------------------------------------------------------
# SECURE_BROWSER_XSS_FILTER: Activa la cabecera 'X-XSS-Protection: 1; mode=block'.
SECURE_BROWSER_XSS_FILTER=True

# SECURE_CONTENT_TYPE_NOSNIFF: Activa la cabecera 'X-Content-Type-Options: nosniff' para evitar MIME-sniffing.
SECURE_CONTENT_TYPE_NOSNIFF=True

# X_FRAME_OPTIONS: Protege la aplicación contra ataques de Clickjacking denegando iframes ('DENY').
X_FRAME_OPTIONS=DENY

# PASSWORD_MIN_LENGTH: Longitud mínima requerida para contraseñas de usuarios en el registro.
PASSWORD_MIN_LENGTH=8

# MAX_LOGIN_ATTEMPTS: Límite de intentos fallidos antes de aplicar bloqueo temporal anti fuerza bruta.
MAX_LOGIN_ATTEMPTS=5


# ------------------------------------------------------------------------------
# 6. PASARELA DE PAGOS: TRANSBANK WEBPAY PLUS (INTEGRACIÓN OFICIAL)
# ------------------------------------------------------------------------------
# TRANSBANK_COMMERCE_CODE: Código de comercio oficial de integración otorgado por Transbank.
# El valor '597055555532' es el código público de pruebas de Webpay Plus para Chile.
TRANSBANK_COMMERCE_CODE=597055555532

# TRANSBANK_API_KEY: Llave de integración pública para ambiente TEST de Transbank.
TRANSBANK_API_KEY=579B532A7440BB061E185D8252273087

# TRANSBANK_ENVIRONMENT: Ambiente de ejecución de la pasarela ('TEST' o 'PRODUCCION').
TRANSBANK_ENVIRONMENT=TEST
