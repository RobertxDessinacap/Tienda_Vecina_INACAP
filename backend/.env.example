# ==============================================================================
# INACAP E-COMMERCE - CONFIGURACIÓN DE SEGURIDAD & ENTORNO (ISO 27001)
# ==============================================================================
# A.8.9: Gestión de la configuración y protección de secretos.
# NUNCA compartas ni subas este archivo a repositorios públicos de Git.

# Configuración del Núcleo Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-inacap-sec-2026-key-iso27001
ALLOWED_HOSTS=127.0.0.1,localhost

# Configuración de Base de Datos PostgreSQL (ORM con psycopg3)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inacap_ecommerce
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Modo de desarrollo: Si PostgreSQL no está activo aún en tu máquina local,
# activa fallback automático a SQLite para pruebas inmediatas sin errores de arranque:
DB_FALLBACK_SQLITE_IF_PG_UNAVAILABLE=True

# Configuración CORS & Seguridad de Red (Restringido al frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Autenticación JWT / Sesión Segura
JWT_SECRET_KEY=inacap-jwt-super-secret-iso27001-signature-key-2026
JWT_EXPIRATION_HOURS=24

# Políticas de Seguridad ISO 27001
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
# Transbank Webpay Plus (Credenciales oficiales de integración)
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB061E185D8252273087
TRANSBANK_ENVIRONMENT=TEST

