# ==============================================================================
# TIENDA VECINA - PLANTILLA DE CONFIGURACION DE ENTORNO (backend/example.env)
# ==============================================================================
# INSTRUCCIONES DE DESPLIEGUE SEGURO:
# 1. Copia esta plantilla a backend/.env:
#    cp backend/example.env backend/.env
# 2. Genera llaves criptograficas unicas de alta entropia (NUNCA uses placeholders):
#    openssl rand -hex 32
# 3. Configura PostgreSQL (el backend opera con comportamiento Fail-Fast: si
#    PostgreSQL no responde, la aplicacion aborta para prevenir split-brain).
# 4. Opcional solo en desarrollo local:
#    python manage.py migrate
#    python manage.py seed_ecommerce

# ------------------------------------------------------------------------------
# 1. NUCLEO DJANGO
# ------------------------------------------------------------------------------
# En produccion DEBE ser False
DEBUG=False
# Genera un secreto unico de 64+ caracteres hexadecimales (ej: openssl rand -hex 32)
SECRET_KEY=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32>
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (FAIL-FAST VIA PSYCOPG 3)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inacap_ecommerce
DB_USER=postgres
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. SEGURIDAD DE RED Y CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# ------------------------------------------------------------------------------
# 4. AUTENTICACION JWT (SECRETO INDEPENDIENTE DE SECRET_KEY)
# ------------------------------------------------------------------------------
# Debe ser distinto a SECRET_KEY. Genera otro valor con: openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE_ME_INDEPENDENT_JWT_SECRET_WITH_OPENSSL_RAND_HEX_32>
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 5. POLITICAS DE SEGURIDAD Y RATE LIMITING (ISO 27001 & OWASP)
# ------------------------------------------------------------------------------
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
THROTTLE_ANON_RATE=120/minute
THROTTLE_USER_RATE=600/minute
THROTTLE_LOGIN_RATE=5/minute
THROTTLE_REGISTER_RATE=3/minute

# ------------------------------------------------------------------------------
# 6. PASARELA DE PAGOS: TRANSBANK WEBPAY PLUS
# ------------------------------------------------------------------------------
# En ambiente TEST usa las credenciales oficiales de integracion de Transbank.
# En PRODUCCION reemplaza con tu codigo de comercio y API key privados.
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB061E185D8252273087
TRANSBANK_ENVIRONMENT=TEST
